{
    "name": "roundly-consulting/onboarding-for-laravel",
    "description": "Define and track multiple onboarding flows for your Laravel application.",
    "keywords": [
        "Roundly Consulting",
        "laravel",
        "onboarding"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/onboarding-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/onboarding-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "roundly-consulting/package-toolkit-for-laravel": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roundly-consulting/testing-for-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Onboarding\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Onboarding\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Onboarding\\OnboardingServiceProvider"
            ],
            "aliases": {
                "Onboarding": "RoundlyConsulting\\Onboarding\\Facades\\Onboarding"
            }
        }
    }
}
